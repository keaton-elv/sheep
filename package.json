{
  "name": "sheep",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Baaaah Farm: a tiny Stardew-style shared todo list where every plan is a sheep.",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "vite build",
    "preview": "vite build && wrangler dev --port 8787",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "types": "wrangler types",
    "deploy": "npm run typecheck && vite build && wrangler deploy"
  },
  "devDependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  }
}
